#!/bin/sh
# Hook git pre-commit : regenere le schema Mongo des acteurs quand le modele Actor est modifie.
#
# Emplacement : rdv-api/.githooks/pre-commit (le depot git est le dossier parent de rdv-api).
# Activation (une fois, depuis la racine du depot git) :
#   git config core.hooksPath rdv-api/.githooks
#
# Se declenche uniquement si le commit contient des fichiers de :
#   - core/model/actor/          (modele Mongo)
#   - service/actors/dto/        (descriptions @Schema)
#   - service/actors/mapper/     (liens modele <-> DTO)
# SchemaExporter ne cree un fichier latest-x.x.x.json5 que si le schema a reellement change ;
# le fichier genere est ensuite ajoute automatiquement au commit.
#
# Le nom du fichier est gere par SchemaExporter : version precedente + 1 (patch).
# Version manuelle (optionnel) : SCHEMA_VERSION=1.14.0 git commit ...

# Dossier du module rdv-api = dossier parent de .githooks (independant de l'endroit ou git s'execute)
MODULE_DIR="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
cd "$MODULE_DIR" || exit 1

PATTERN='core/model/actor/|service/actors/(dto|mapper)/'
SCHEMA_DIR="src/main/resources/schema/mongodb/actors"

# 1. Le commit touche-t-il le modele Actor (dans ce module) ? Sinon on ne fait rien.
if ! git diff --cached --name-only --relative | grep -Eq "$PATTERN"; then
  exit 0
fi

echo "[schema] Modele Actor modifie : verification du schema Mongo..."

# 2. Compile puis lance SchemaExporter (le meme que dans IntelliJ), depuis rdv-api
mvn -q compile exec:java \
  "-Dexec.mainClass=com.rcibs.rdv.api.business.corp.schema.SchemaExporter" \
  "-Dschema.version=$SCHEMA_VERSION" \
  || { echo "[schema] Echec de la generation : commit annule."; exit 1; }

# 3. Ajoute au commit le(s) fichier(s) genere(s) ou modifie(s)
git add "$SCHEMA_DIR"/latest-*.json5
echo "[schema] Schema a jour et ajoute au commit."
